; EPhoneMic.inf — virtual microphone (WO-style), SysVAD fork.
; v0 skeleton INF. Real SYS: copy Microsoft SysVAD sample, strip to 1 capture pin,
; rename device to ePhone Mic, add IOCTL feeder. This INF wires install + signing attrs.
; Dev install: testsigning on. Release: EV cert + Partner Center attestation.

[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/09/2026,0.1.0
CatalogFile=EPhoneMic.cat
PnpLockdown=1

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
EPhoneMic.sys=1

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%Mfg%=EPhone,NTamd64

[EPhone.NTamd64]
%EPhoneMic.DeviceDesc%=EPhoneMic_Device, SWD\MMDEVAPI\EPhoneMic

[EPhoneMic_Device.NT]
CopyFiles=EPhoneMic_Copy
AddReg=EPhoneMic_AddReg

[EPhoneMic_Copy]
EPhoneMic.sys

[EPhoneMic_Device.NT.Services]
AddService=EPhoneMic,2,EPhoneMic_Service

[EPhoneMic_Service]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\EPhoneMic.sys

[EPhoneMic_AddReg]
HKR,,FriendlyName,,%EPhoneMic.DeviceDesc%
HKR,,DeviceType,0x10001,0x00000001 ; capture endpoint shows as mic

[Strings]
Provider="ePhone"
Mfg="ePhone"
Disk="ePhone Mic install disk"
EPhoneMic.DeviceDesc="ePhone Mic"
