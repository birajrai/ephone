<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.10" />
    <PackageReference Include="obs-websocket-dotnet" Version="5.7.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="PortAudioSharp" Version="0.3.0" />
  </ItemGroup>

  <!-- Own virtual camera beside exe so EPhoneCam.TryStart finds it. -->
  <Target Name="CopyEPhoneCam" AfterTargets="Build" Condition="Exists('..\..\driver\cam\x64\Release\EPhoneCam.dll')">
    <Copy SourceFiles="..\..\driver\cam\x64\Release\EPhoneCam.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
